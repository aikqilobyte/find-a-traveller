# ============================================================
# Find A Traveller — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional) ---
# Leave unset to use the built-in development/test payment flow instead
# of real Stripe. Both paths are implemented in src/lib/payments/.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OAuth (optional, for future Google/Apple sign-in) ---
# Configure the corresponding provider in Supabase Auth settings; no app
# code changes are required beyond what's already wired in src/lib/auth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# --- AI support assistant (optional) ---
# Leave unset and the help widget simply hides the "ask" option.
# Get a key at console.anthropic.com. Short answers cost a fraction of a
# penny each; set a spend limit in the console to be certain.
ANTHROPIC_API_KEY=
