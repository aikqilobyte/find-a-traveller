# ============================================================
# Find A Traveller — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional) ---
# Leave unset to use the built-in development/test payment flow instead of
# real Stripe. Both paths are implemented, and the Pay button picks between
# them server-side, so removing these keys does not break booking.
#
# Test keys start sk_test_ / pk_test_ and move no real money: card
# 4242 4242 4242 4242 with any future expiry and any CVC always succeeds.
#
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create at
# dashboard.stripe.com pointing to /api/webhooks/stripe, listening for
# checkout.session.completed. Without it payments are taken but never
# settle, because the webhook is what advances the booking.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI support assistant (optional) ---
# Leave unset and the help widget simply hides the "ask" option.
# Get a key at console.anthropic.com. Short answers cost a fraction of a
# penny each; set a spend limit in the console to be certain.
ANTHROPIC_API_KEY=

# --- Social sign-in (optional) ---
# Set to true only after the provider is configured in Supabase, or the
# button will appear and fail. The client ID and secret themselves are NOT
# set here: they go into the Supabase dashboard under Authentication >
# Providers, so the app never handles them.
NEXT_PUBLIC_OAUTH_GOOGLE=false
NEXT_PUBLIC_OAUTH_FACEBOOK=false
